# Ensure devDependencies are installed during the build step.
# Vite (build bundler) and TypeScript (compiler) are declared as devDependencies,
# which is correct — they are not needed at runtime. However, they ARE required
# at build time, so npm ci must install them even when NODE_ENV=production.
#
# Render and similar PaaS platforms may skip devDependencies when NODE_ENV=production.
# This file ensures devDependencies are always included during installation so that
# `npm run build` (which invokes vite and tsc) succeeds.
include=dev
